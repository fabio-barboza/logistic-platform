# Config local da stack. Copie para .env e rode ./start.sh
# Lido pelo Docker Compose, pelo start.sh/start.ps1 e pelo Vite do webui (só as VITE_*).
#
# NENHUMA das variáveis abaixo (exceto o bloco de Langfuse, que é opcional por natureza) tem
# default no código-fonte: application.yml/auth.js/main.js exigem o valor real e a aplicação
# quebra no boot se ele faltar. Isso é deliberado — um default "de conveniência" já fez a
# stack subir silenciosamente apontando para o modelo/host errado (ver CLAUDE.md/histórico:
# um eval inteiro rodou contra localhost:8200/qwen3.6:35B em vez de deepseek, porque a env var
# não estava setada e o antigo default mascarou o erro). Todo o bloco abaixo tem que estar
# descomentado e preenchido no seu .env.

# --- LLM (logistic-agent) ---
# A chave que desliga o reasoning muda de modelo para modelo (Qwen usa chat_template_kwargs,
# DeepSeek usa thinking.type) — vai crua em LLM_EXTRA_BODY (JSON), decodificada em
# ChatClientConfig.parseExtraBody. Mesmo padrão do resume-platform (MAIN_MODEL_EXTRA_BODY).
# LLM_EXTRA_BODY é a única opcional deste bloco: sem ela, nenhuma chave extra é enviada.
LLM_BASE_URL="http://localhost:4000"
LLM_API_KEY="sk-..."
LLM_MODEL="deepseek-flash"
LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
# Exemplo alternativo (Qwen local via llama-server):
# LLM_BASE_URL="http://localhost:8200"
# LLM_MODEL="qwen3.6:35B"
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# --- logistic-agent -> logistic-api (MCP + healthcheck) ---
LOGISTIC_API_URL="http://localhost:8081"

# --- Banco do logistic-api (logisticdb, container "postgres" do docker-compose.yaml) ---
API_DB_URL="jdbc:postgresql://localhost:5432/logisticdb?prepareThreshold=0"
API_DB_USER="postgres"
API_DB_PASSWORD="postgres"
# Role read-only usada só por QueryService/executeQuery (V2__readonly_role.sql).
API_READONLY_DB_USER="logistic_ro"
API_READONLY_DB_PASSWORD="logistic_ro"

# --- Banco do logistic-agent (agentdb, container "agentdb" do docker-compose.yaml) ---
# Banco exclusivo do agent: chat memory, pendências de confirmação e ofertas de gráfico. Não é
# o banco de domínio — o agent não tem acesso a ele.
AGENT_DB_URL="jdbc:postgresql://localhost:5433/agentdb"
AGENT_DB_USER="agent"
AGENT_DB_PASSWORD="agent"

# --- webui ---
VITE_API_URL="http://localhost:8080/api/chat"

# --- Keycloak (autenticação) ---
KEYCLOAK_ISSUER_URI="http://localhost:8090/realms/logistic"
KEYCLOAK_AGENT_CLIENT_SECRET="logistic-agent-secret"
VITE_KEYCLOAK_URL="http://localhost:8090"
VITE_KEYCLOAK_REALM="logistic"
VITE_KEYCLOAK_CLIENT_ID="logistic-webui"

# --- Observabilidade (Langfuse) ---
# Único bloco realmente opcional: desligado por padrão (LANGFUSE_CLIENT_ENABLED default
# false), e application.yml mantém default para LANGFUSE_OTLP_ENDPOINT/LANGFUSE_AUTH de
# propósito — são propriedades do autoconfig do Spring Boot (management.opentelemetry.*),
# resolvidas no boot independente de qualquer flag condicional nossa, então sem default aqui
# a stack quebraria mesmo com o Langfuse desligado. LANGFUSE_SERVER_ENABLED sobe os
# containers daqui; LANGFUSE_CLIENT_ENABLED faz o agent exportar traces. São independentes.
# Atenção: o Compose testa se LANGFUSE_SERVER_ENABLED está vazia, não se vale "true" —
# para desligar, comente as duas linhas; "=false" continua ligando.
# LANGFUSE_SERVER_ENABLED=true
# COMPOSE_PROFILES=${LANGFUSE_SERVER_ENABLED:+langfuse}
# LANGFUSE_CLIENT_ENABLED=true
# LANGFUSE_PUBLIC_KEY="pk-lf-logistic-platform"
# LANGFUSE_SECRET_KEY="sk-lf-logistic-platform"
# LANGFUSE_BASE_URL="http://localhost:8060"
# LANGFUSE_OTLP_ENDPOINT="http://localhost:8060/api/public/otel/v1/traces"
