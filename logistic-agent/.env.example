# Observabilidade com Langfuse — opcional e desligada por padrão.
# Copie este arquivo para logistic-agent/.env. Sem ele, a stack sobe igual, só sem tracing.
#
#   docker compose -f logistic-agent/docker-compose.yaml up -d   # Langfuse em :8060
#   cp logistic-agent/.env.example logistic-agent/.env
#   ./start.sh
#
# As chaves abaixo são as que aquele compose provisiona no primeiro boot — funcionam sem
# nenhum clique na UI. Login em http://localhost:8060: admin@logistic.local / logistic123.
# Usando um Langfuse que já existe? Troque pelas chaves do seu projeto
# (Settings -> API Keys) e, se ele não estiver em :8060, ajuste o endpoint OTLP no fim.

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY="pk-lf-logistic-platform"
LANGFUSE_SECRET_KEY="sk-lf-logistic-platform"
LANGFUSE_BASE_URL="http://localhost:8060"

# O start.sh deriva o LANGFUSE_AUTH = base64("public-key:secret-key") a partir das duas acima.

# Langfuse em outra porta ou host:
# LANGFUSE_OTLP_ENDPOINT="http://localhost:8060/api/public/otel/v1/traces"
